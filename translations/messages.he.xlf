<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="he" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>No failed tests to run again</source>
        <target>אין בדיקות שנכשלו להרצה חוזרת</target>
      </trans-unit>
      <trans-unit id="2">
        <source>✗ %count% test failing|✗ %count% tests failing</source>
        <target>✗ בדיקה %count% נכשלת|✗ %count% בדיקות נכשלות</target>
      </trans-unit>
      <trans-unit id="3">
        <source>PHPUnit was stopped before it finished</source>
        <target>PHPUnit נעצר לפני שסיים</target>
      </trans-unit>
      <trans-unit id="4">
        <source>PHPUnit exited with code %code% without a report — see its terminal tab</source>
        <target>PHPUnit הסתיים בקוד %code% ללא דוח — ראו את לשונית המסוף שלו</target>
      </trans-unit>
      <trans-unit id="5">
        <source>PHPUnit ran no tests</source>
        <target>PHPUnit לא הריץ אף בדיקה</target>
      </trans-unit>
      <trans-unit id="6">
        <source>%count% test passed|%count% tests passed</source>
        <target>בדיקה %count% עברה|%count% בדיקות עברו</target>
      </trans-unit>
      <trans-unit id="7">
        <source>%failed% of %count% tests failed</source>
        <target>%failed% מתוך %count% בדיקות נכשלו</target>
      </trans-unit>
      <trans-unit id="8">
        <source>passed</source>
        <target>עברה</target>
      </trans-unit>
      <trans-unit id="9">
        <source>skipped</source>
        <target>דולגה</target>
      </trans-unit>
      <trans-unit id="10">
        <source>Open a PHPUnit test file first</source>
        <target>פתחו קודם קובץ בדיקות של PHPUnit</target>
      </trans-unit>
      <trans-unit id="11">
        <source>%file% declares no test class</source>
        <target>%file% אינו מצהיר על מחלקת בדיקה</target>
      </trans-unit>
      <trans-unit id="12">
        <source>Tests</source>
        <target>בדיקות</target>
      </trans-unit>
      <trans-unit id="13">
        <source>PHPUnit: Run Test at Caret</source>
        <target>PHPUnit: הרצת הבדיקה בסמן</target>
      </trans-unit>
      <trans-unit id="14">
        <source>PHPUnit: Run Tests in File</source>
        <target>PHPUnit: הרצת הבדיקות בקובץ</target>
      </trans-unit>
      <trans-unit id="15">
        <source>PHPUnit: Run All Tests</source>
        <target>PHPUnit: הרצת כל הבדיקות</target>
      </trans-unit>
      <trans-unit id="16">
        <source>PHPUnit: Rerun Failed Tests</source>
        <target>PHPUnit: הרצה חוזרת של בדיקות שנכשלו</target>
      </trans-unit>
    </body>
  </file>
